# NOTE: do not set `optional=false` here. Modern toolchains ship their native
# code as platform-specific OPTIONAL dependencies, and skipping them breaks
# them in confusing ways:
#   - jest-resolve -> unrs-resolver needs @unrs/resolver-binding-<platform>.
#     Without it, jest fails with a misleading "Module <rootDir>/jest.setup.js
#     in the setupFilesAfterEnv option was not found" even though the file is
#     right there -- the resolver is what is broken, not the path.
#   - @sentry/nextjs' build-time wrapping loader needs rollup, which needs
#     @rollup/rollup-<platform>, or `next build` fails outright.
# npm picks the right binary per platform, so letting it do that is correct on
# Linux CI and on macOS dev machines alike.

# Ensure we use the correct registry
registry=https://registry.npmjs.org/

# Skip platform-specific binaries that might not be available
ignore-scripts=false

# Force npm to rebuild packages for the current platform
# This helps with native dependencies
rebuild-bundle=true

# Set platform-specific overrides
platform=linux
arch=x64 